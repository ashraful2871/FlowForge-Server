NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://flowforge:flowforge@localhost:5433/flowforge?schema=public"
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Sessions: absolute lifetime and inactivity timeout
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# Frontend URL, used to build invite and password reset links
APP_URL=http://localhost:3000