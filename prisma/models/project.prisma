model Project {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  key            String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  taskCounter    Int           @default(0)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  number         Int
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String?
  reportedId     String?
  dueDate        DateTime?    @db.Date
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     User?        @relation("TaskReporter", fields: [reportedId], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@unique([projectId, number])
  @@unique([id, organizationId])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId])
}

model Comment {
  id             String    @id @default(uuid())
  organizationId String
  taskId         String
  authorId       String?
  body           String
  editAt         DateTime?
  deleteAt       DateTime?
  createdAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}
